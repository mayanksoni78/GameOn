{
  "expo": {
    "name": "Game On",
    "slug": "gameon",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon_gameon.png",
    "scheme": "projectinterface",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.krishana97.gameon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "runtimeVersion": "exposdk:54.0.0",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon_gameon.png",
        "backgroundColor": "#07050E"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.krishana97.gameon"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon_gameon.png",
      "backgroundColor": "#07050E"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon_gameon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#07050E"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87b35f30-5317-4141-84a1-d9cf6725b99e"
      }
    },
    "owner": "krishana97",
    "updates": {
      "url": "https://u.expo.dev/87b35f30-5317-4141-84a1-d9cf6725b99e",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    }
  }
}
